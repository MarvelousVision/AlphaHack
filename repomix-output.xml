from pydantic import BaseModel, Field, ConfigDict, model_validator

PARAM_RANGES = {
    "dtr": {"max_depth": (3, 30), "min_samples_leaf": (1, 20)},
    "dtc": {"max_depth": (3, 30), "min_samples_leaf": (1, 20)},

