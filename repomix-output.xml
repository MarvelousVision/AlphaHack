def choir(m1: str,
          m2: str,
          m3: str,
          time_left: int,
          task: str,
          cat: list,
          numeric: list,
          train: pd.DataFrame,
          target: np.ndarray,
          tgt: str,
          test: pd.DataFrame,
          test_ids: np.ndarray,
          id_name: str) -> pd.DataFrame:

    if time_left <= 0:
        raise ValueError('time_left must be positive.')

    started = monotonic()
