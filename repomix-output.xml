        "n_estimators": (200, 1200),
        "subsample": (0.6, 1.0),
        "colsample_bytree": (0.6, 1.0),
        "reg_lambda": (0, 10),
    },
    "xbc": {
        "max_depth": (3, 10),
        "learning_rate": (0.01, 0.2),
        "n_estimators": (200, 1200),
        "subsample": (0.6, 1.0),
        "colsample_bytree": (0.6, 1.0),
        "reg_lambda": (0, 10),
    },
    "cbr": {
        "iterations": (100, 2000),
        "depth": (2, 10),
        "learning_rate": (0.01, 0.3),
        "l2_leaf_reg": (1, 20),
        "random_seed": (0, 2147483647),
    },
    "cbc": {
        "iterations": (100, 2000),
        "depth": (2, 10),
        "learning_rate": (0.01, 0.3),
        "l2_leaf_reg": (1, 20),
        "random_seed": (0, 2147483647),
    },
}

INT_PARAMS = {
    "max_depth", "min_samples_leaf", "n_estimators",
    "num_leaves", "min_child_samples",
    "iterations", "depth", "random_seed",
}
class ModelConfig(BaseModel):
    model_config = ConfigDict(extra="forbid")

    name: Literal[
    "cbr", "cbc", "lnr",
    "dtr", "dtc",
    "rfr", "rfc",
    "svr", "svc",
    "lvr", "lvc",
    "lbr", "lbc",
    "xbr", "xbc"
    ]
    hyperparameters: dict[str, Any] = Field(default_factory=dict)
    @model_validator(mode="after")
    def validate_hyperparameters(self):
        params = self.hyperparameters
        allowed = PARAM_RANGES.get(self.name, {})
       
        for key, value in params.items():
            if self.name in ("svc", "svr") and key == "gamma":
                if value not in ("scale", "auto"):
                    raise ValueError("gamma must be scale or auto")
                continue
            if self.name in ("cbr", "cbc") and key == "verbose":
                if type(value) is not bool:
                    raise ValueError("verbose must be boolean")
                continue
            if key not in allowed:
                raise ValueError(
                    f"{key} is not allowed for {self.name}"
                )

            if value is None and key == "max_depth" and self.name in ("rfr", "rfc"):
                continue

            low, high = allowed[key]

            if key in INT_PARAMS:
                if type(value) is not int:
                    raise ValueError(f"{key} must be an integer")
            elif type(value) not in (int, float):
                raise ValueError(f"{key} must be numeric")

            if not low <= value <= high:
                raise ValueError(
                    f"{key} must be between {low} and {high}"
                )

        return self

class PreprocessingConfig(BaseModel):
    model_config = ConfigDict(extra="forbid")

    missing_values: Literal["native", "median", "mean", "most_frequent"]
    categorical_encoding: Literal[ "native", "onehot", "ordinal"]
    scaling: Literal["none", "standard", "robust"]


class FeatureConfig(BaseModel):
    model_config = ConfigDict(extra="forbid")

    strategy: Literal["baseline"] = "baseline"
    drop_columns: list[str] = Field(default_factory=list)


class ExperimentPlan(BaseModel):
    model_config = ConfigDict(extra="forbid")

    action: Literal["run_experiment"]
    hypothesis: str = Field(min_length=1)

    model: ModelConfig
    features: FeatureConfig

    reasoning: str = Field(min_length=1)
    estimated_time_sec: int = Field(gt=0, le=10800)

class MetricResult(BaseModel):
    name: str
    value: float
    direction: Literal["maximize", "minimize"]


class ExperimentResult(BaseModel):
    experiment_id: str
    status: Literal["success", "failed"]
    model_name: str

    metric: MetricResult | None = None
    cv_std: float | None = Field(default=None, ge=0, allow_inf_nan=False)
    duration_sec: float = Field(ge=0)
    error: str | None = None


class EnsemblePlan(BaseModel):
    model_config = ConfigDict(extra="forbid")

    action: Literal["run_ensemble"]
    hypothesis: str = Field(min_length=1)
    models: tuple[str, str, str]
    reasoning: str = Field(min_length=1)

    @model_validator(mode="after")
    def validate_models(self):
        valid_models = set(
            ModelConfig.model_fields["name"].annotation.__args__
        )
        if len(set(self.models)) != 3:
            raise ValueError("Models must be unique")
        for name in self.models:
            if name not in valid_models:
                raise ValueError(f"Unknown model: {name}")
        return self

    def validate_task(self, task_type: str):
        regression_models = {
            "cbr", "lnr", "dtr", "rfr",
            "svr", "lvr", "lbr", "xbr"
        }
        classification_models = {
            "cbc", "dtc", "rfc", "svc",
            "lvc", "lbc", "xbc"
        }
        if task_type == "regression":
            allowed = regression_models
        elif task_type in ("binary", "multiclass"):
            allowed = classification_models
        else:
            raise ValueError(f"Unknown task type: {task_type}")
        invalid = [
            name for name in self.models
            if name not in allowed
        ]
        if invalid:
            raise ValueError(
                f"Models incompatible with {task_type}: {invalid}"
            )

        return self
